{
  "name": "openai-ws-workshop1",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "main": "server/worker.mjs",
  "assets": {
    "directory": "./dist-workshop1",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
