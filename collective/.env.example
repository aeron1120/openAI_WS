# 통합 사이트 환경값 예시. 실제 값은 이 파일을 복사한 collective/.env(로컬, Git에 안 올라감)나
# Cloudflare Pages 대시보드 → Settings → Variables and Secrets에 넣습니다. 비밀값을 이 파일에 적지 마세요.

# --- 로컬 실행 (npm run dev:collective) ---
# local: 파일(collective/.data/)에 저장하고, localhost에서만 열리는 개발용 로그인을 씁니다. 운영 사이트에서는 켜지지 않습니다.
CMS_MODE=local
PUBLIC_ORIGIN=http://localhost:5180
# 관리자 Google 계정(쉼표로 여러 개). 로컬 모드에서는 첫 번째 계정으로 개발용 로그인합니다.
ADMIN_EMAILS=

# --- 운영 (Cloudflare Pages: student-collective) ---
# CMS_MODE는 넣지 않습니다(운영 함수가 항상 production으로 시작).
# PUBLIC_ORIGIN=https://student-collective.pages.dev
# ADMIN_EMAILS=
# SESSION_SECRET=            (secret, 32자 이상 무작위 값)
# GOOGLE_CLIENT_ID=          (관리자 로그인용 OAuth 클라이언트)
# GOOGLE_CLIENT_SECRET=      (secret)
# SUPABASE_URL=              (기존 Supabase 프로젝트 URL)
# SUPABASE_SERVICE_KEY=      (secret, CMS 전용으로 새로 만든 secret 키 sb_secret_…)
# SNU_LEGACY_ORIGIN=https://snu-student-collective.pages.dev
# SITE_NAME=Student Collective
